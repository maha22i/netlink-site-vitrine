# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://netlinksolutions.pro

# Vérification de propriété — uniquement la valeur de l'attribut content de la balise meta fournie
# Google Search Console : https://search.google.com/search-console (méthode « Balise HTML »)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools : https://www.bing.com/webmasters
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Formulaires contact et candidature — https://www.emailjs.com
# Clés lues uniquement par le serveur. Ne pas préfixer la clé privée par NEXT_PUBLIC_.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_TEMPLATE_CONTACT=
EMAILJS_TEMPLATE_CAREER=

# Chatbot Orkiva : jeton API serveur (Intégrations > Jetons API). Jamais côté navigateur.
ORKIVA_API_TOKEN=
